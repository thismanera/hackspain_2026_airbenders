{
  "name": "plantilla-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start -H 0.0.0.0",
    "test": "node scripts/run-tests.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:setup:force": "node scripts/setup-db.mjs --force",
    "scoring:fit": "node --import tsx scripts/scoring.ts fit",
    "scoring:score": "node --import tsx scripts/scoring.ts score",
    "forecast:fit": "node --import tsx scripts/forecast.ts fit",
    "forecast:run": "node --import tsx scripts/forecast.ts run",
    "forecast:backtest": "node --import tsx scripts/forecast.ts backtest",
    "scoring:decide": "node --import tsx scripts/scoring.ts decide",
    "scoring:backtest": "node --import tsx scripts/scoring.ts backtest",
    "scoring:import": "node --conditions=react-server --import tsx scripts/scoring.ts import",
    "helmcode:check": "node --conditions=react-server --import tsx scripts/helmcode-check.ts",
    "lint": "cross-env NODE_OPTIONS=\"--import tsx\" oxlint --ignore-pattern \".claude/**\" --format unix",
    "lint:fix": "cross-env NODE_OPTIONS=\"--import tsx\" oxlint --ignore-pattern \".claude/**\" --fix --format unix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "prisma:seed": "tsx prisma/seed.ts",
    "auth:generate": "auth generate --config lib/core/auth.ts --output ./prisma/schema/auth.prisma --yes",
    "rename-project": "node scripts/rename-project.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.5",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "auth": "^1.6.27",
    "cross-env": "^10.1.0",
    "knip": "^6.32.1",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "description": "Plantilla base para proyectos Next.js 16 (Prisma, Tailwind 4, TanStack Query, shadcn/ui).",
  "license": "UNLICENSED",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
