# Postgres connection string used by Prisma (lib/core/db.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/plantilla_nextjs"

# Canonical origin of this deployment, used for server-side fetches during
# TanStack Query prefetching (see app/tasks/page.tsx) and any absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth (lib/core/auth.ts). Generate a real secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:3000"
