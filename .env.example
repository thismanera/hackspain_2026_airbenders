# Postgres connection string used by Prisma (lib/core/db.ts).
# Pega aquí la connection string "Pooled connection" de tu proyecto Neon
# (Dashboard → Connect), que ya incluye sslmode=require:
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Canonical origin of this deployment, used for server-side fetches during
# TanStack Query prefetching (see app/tasks/page.tsx) and any absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth (lib/core/auth.ts). Generate a real secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:3000"

# Helmcode: inferencia LLM OpenAI-compatible del sponsor (lib/integrations/helmcode.ts).
# La key real (sk-hke_...) la reparte el equipo por canal privado; NUNCA la commitees
# ni la expongas con prefijo NEXT_PUBLIC_. Solo se lee en servidor.
# Comprueba que funciona con `pnpm helmcode:check`.
HELMCODE_API_KEY="sk-hke_pega-aqui-la-key"
HELMCODE_BASE_URL="https://api.helmcode.com/v1"
# Modelos del sponsor: deepseek-v4-flash (1M ctx, tool calling) o glm5.3 (1M ctx, solo texto)
HELMCODE_MODEL="deepseek-v4-flash"
